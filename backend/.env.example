# OpenRouter API Key & Model Selection (Primary unified agent LLM provider)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key_here"
OPENROUTER_MODEL="cohere/north-mini-code:free"

# Optional Groq API Key (Llama 3.3 70B & Llama 3.1 8B; falls back to OpenRouter when omitted)
GROQ_API_KEY=""

# Supabase Configuration (PostgreSQL + pgvector)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Optional Application Settings
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_NAME="CareerLoop"
